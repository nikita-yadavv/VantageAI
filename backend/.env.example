# PGAGI System Environment Configuration

PROJECT_NAME="PGAGI Role-Based Screening Engine"
ENVIRONMENT="development"
DEBUG=True

# Server
HOST="0.0.0.0"
PORT=8000

# SQLite Persistence
DATABASE_URL="sqlite:///./screening_system.db"

# LLM Providers (Optional: System operates fully offline with built-in high-fidelity heuristic generator)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
PRIMARY_LLM_PROVIDER="auto" # 'gemini', 'openai', or 'heuristic'
DEFAULT_GEMINI_MODEL="gemini-1.5-flash"
DEFAULT_OPENAI_MODEL="gpt-4o-mini"

# RAG & Knowledge Base
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=3
